{
  "name": "valpas",
  "version": "0.0.2",
  "description": "Valpas",
  "license": "EUPL-1.1",
  "engines": {
    "node": ">=24",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "start": "node autoclear.js && PUBLIC_URL=/valpas node watch.mjs",
    "start:watch": "concurrently \"pnpm run start\" \"pnpm run typecheck:watch\"",
    "start:raamit": "node autoclear.js --dev-raamit && VIRKAILIJA_RAAMIT_HOST=true OPPIJA_RAAMIT_HOST=true PUBLIC_URL=/valpas node watch.mjs",
    "start:integration": "node autoclear.js --integration && PUBLIC_URL=/valpas node watch.mjs",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node autoclear.js --unittest && jest --runInBand src",
    "test:integration": "pnpm run build:local && jest --config jest.integrationtests.config.js --runInBand test/integrationtests",
    "test:integration:debug": "pnpm run build:local && SHOW_BROWSER=true jest --config jest.integrationtests.config.js --runInBand test/integrationtests",
    "build:local": "node autoclear.js && PUBLIC_URL=/valpas parcel build src/index.html --public-url /valpas/assets --dist-dir dist-nonce --no-scope-hoist && node postbuild-exec.mjs",
    "build:prod": "node autoclear.js --prod && PUBLIC_URL=/valpas parcel build src/index.html --public-url /valpas/assets --dist-dir dist-nonce --no-scope-hoist && node postbuild-exec.mjs",
    "lint": "pnpm run typecheck && pnpm run eslint && pnpm run stylelint && pnpm run prettier",
    "lint:check": "concurrently --group \"pnpm:typecheck\" \"pnpm:eslint:check\" \"pnpm:stylelint:check\" \"pnpm:prettier:check\"",
    "eslint": "pnpm run eslint:check --fix",
    "eslint:check": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "stylelint": "pnpm run stylelint:check --fix",
    "stylelint:check": "stylelint \"src/**/*.less\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.node.json",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "clean": "jest --clearCache && rm -rf dist && rm -rf dist-nonce && rm -rf ../target/webapp/koski/valpas && rm -rf .parcel-cache",
    "prettier": "prettier --write --cache .",
    "prettier:check": "prettier --check --cache ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Opetushallitus/koski.git"
  },
  "homepage": "https://github.com/Opetushallitus/koski#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@jest/test-sequencer": "30.5.2",
    "@parcel/config-default": "2.14.4",
    "@parcel/core": "2.14.4",
    "@parcel/transformer-less": "2.14.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/downloadjs": "1.4.6",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@types/selenium-webdriver": "4.35.7",
    "cheerio": "1.2.0",
    "concurrently": "9.2.4",
    "dotenv": "16.6.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-expect-message": "1.1.3",
    "jest-fail-on-console": "3.3.4",
    "jest-fetch-mock": "3.2.0",
    "js-cookie": "3.0.8",
    "node-fetch": "3.3.2",
    "parcel": "2.14.4",
    "postcss-less": "6.0.0",
    "prettier": "3.9.9",
    "selenium-webdriver": "4.49.0",
    "stylelint": "17.15.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "tree-kill": "1.2.2",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "bem-ts": "0.15.1",
    "copy-to-clipboard": "3.3.3",
    "date-fns": "4.4.0",
    "downloadjs": "1.4.7",
    "fp-ts": "2.16.11",
    "react": "19.3.0",
    "react-calendar": "6.0.1",
    "react-date-picker": "12.1.0",
    "react-dom": "19.3.0",
    "react-router-dom": "5.3.4"
  },
  "alias": {
    "memoize": "./node_modules/.pnpm/memoize@10.2.0/node_modules/memoize/distribution/index.js"
  },
  "packageManager": "pnpm@10.34.5"
}
