{
  "name": "koski-json-schema-viewer",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build:prod": "webpack --bail --mode production",
    "watch": "webpack --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && pnpm run prettier",
    "lint:check": "pnpm run typecheck",
    "prettier": "../node_modules/.bin/prettier --write --cache .",
    "prettier:check": "../node_modules/.bin/prettier --check --cache ."
  },
  "dependencies": {
    "d3": "3.5.17",
    "highlight.js": "8.8.0",
    "jquery": "3.7.1",
    "jquery-migrate": "3.6.0",
    "jquery.scrollto": "1.4.14",
    "jsonpointer.js": "0.4.0",
    "tv4": "1.2.7",
    "urijs": "1.19.11"
  },
  "devDependencies": {
    "@babel/helper-compilation-targets": "7.29.7",
    "@swc/core": "1.16.12",
    "css-minimizer-webpack-plugin": "8.0.0",
    "swc-loader": "0.2.7",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  }
}
