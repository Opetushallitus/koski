{
  "name": "omadata-oauth2-sample",
  "version": "0.0.2",
  "description": "Sample web application to use KOSKI OmaData with OAuth2",
  "engines": {
    "node": ">=24",
    "pnpm": "10.34.5"
  },
  "type": "module",
  "scripts": {
    "generate-certs": "./testca/generate-certs.sh",
    "start:alb-proxy": "../scripts/start-alb-proxy.sh",
    "start:node-sample": "../scripts/start-node-sample.sh",
    "start:java-sample": "../scripts/start-java-sample.sh",
    "test:e2e": "pnpm -C ../../smoketests run omadata:local",
    "playwright:test": "pnpm exec playwright test",
    "lint": "pnpm run typecheck && pnpm run lint:problems",
    "lint:problems": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
    "fix": "pnpm run prettier && eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\" --fix",
    "prettier": "pnpm --dir ../.. exec prettier --write \"omadata-oauth2-sample/server/{src,test}/**/*.{js,jsx,ts,tsx}\"",
    "prettier:check": "pnpm --dir ../.. exec prettier --check \"omadata-oauth2-sample/server/{src,test}/**/*.{js,jsx,ts,tsx}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Opetushallitus/koski.git"
  },
  "license": "EUPL-1.1",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1141.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "openid-client": "6.8.8",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "packageManager": "pnpm@10.34.5"
}
