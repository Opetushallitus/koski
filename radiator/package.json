{
  "name": "radiator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "ts-node src/index.ts prod",
    "monitor:local": "ts-node src/index.ts local",
    "monitor:dev": "ts-node src/index.ts dev",
    "monitor:qa": "ts-node src/index.ts qa",
    "monitor:prod": "ts-node src/index.ts prod",
    "lint": "pnpm run typecheck && pnpm run eslint && pnpm run prettier",
    "lint:check": "concurrently --group \"pnpm:typecheck\" \"pnpm:eslint:check\" \"pnpm:prettier:check\"",
    "eslint": "pnpm run eslint:check --fix",
    "eslint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prettier": "prettier --write --cache .",
    "prettier:check": "prettier --check --cache ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "16.6.1",
    "fp-ts": "2.16.11",
    "tail": "2.2.6",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/tail": "2.2.3",
    "concurrently": "9.2.4",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "pnpm": "10.34.5",
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5"
}
