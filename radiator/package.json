{
  "name": "radiator",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts prod",
    "monitor:local": "node --env-file-if-exists=.env src/index.ts local",
    "monitor:dev": "node --env-file-if-exists=.env src/index.ts dev",
    "monitor:qa": "node --env-file-if-exists=.env src/index.ts qa",
    "monitor:prod": "node --env-file-if-exists=.env src/index.ts prod",
    "lint": "pnpm run typecheck && pnpm run eslint && pnpm run prettier",
    "lint:check": "concurrently --group \"pnpm:typecheck\" \"pnpm:eslint:check\" \"pnpm:prettier:check\"",
    "eslint": "pnpm run eslint:check --fix",
    "eslint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prettier": "prettier --write --cache .",
    "prettier:check": "prettier --check --cache .",
    "clean": "rm -rf node_modules/.cache",
    "wipe": "pnpm run clean && pnpm purge"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "fp-ts": "2.16.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "engines": {
    "pnpm": "12.10.0",
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.0"
}
