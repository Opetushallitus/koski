{
  "name": "koski",
  "version": "0.0.2",
  "description": "Koski",
  "license": "EUPL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Opetushallitus/koski.git"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "12.9.1"
  },
  "dependencies": {
    "@skidding/react-codemirror": "1.0.2",
    "bacon.atom": "5.0.6",
    "baconjs": "1.0.1",
    "baret": "1.2.0",
    "codemirror": "5.65.21",
    "fecha": "4.2.3",
    "font-awesome": "4.7.0",
    "fp-ts": "2.16.11",
    "js-cookie": "3.0.8",
    "normalize.css": "8.0.1",
    "optics-ts": "2.4.1",
    "partial.lenses": "9.8.0",
    "ramda": "0.32.0",
    "react": "16.14.0",
    "react-day-picker": "7.4.10",
    "react-dom": "16.14.0",
    "react-focus-lock": "2.13.7",
    "react-highlight": "0.15.0",
    "react-highlighter": "0.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/helper-compilation-targets": "8.0.6",
    "@eslint-react/eslint-plugin": "5.23.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.13",
    "@types/js-cookie": "3.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.1",
    "@types/ramda": "0.32.0",
    "@types/react": "16.14.70",
    "@types/react-dom": "16.9.25",
    "chai": "6.3.0",
    "concurrently": "10.0.5",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jquery": "4.0.0",
    "less": "4.9.1",
    "less-loader": "13.0.0",
    "mocha": "12.0.3",
    "postcss": "8.5.29",
    "postcss-less": "6.0.0",
    "postcss-loader": "8.2.1",
    "postcss-preset-env": "11.5.5",
    "prettier": "3.9.9",
    "puppeteer": "25.12.0",
    "style-loader": "4.0.0",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "swc-loader": "0.2.7",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "scripts": {
    "lint": "pnpm run typecheck && pnpm run eslint && pnpm run stylelint && pnpm run prettier",
    "lint:check": "concurrently --group \"pnpm:typecheck\" \"pnpm:eslint:check\" \"pnpm:stylelint:check\" \"pnpm:prettier:check\"",
    "eslint": "pnpm run eslint:check --fix",
    "eslint:check": "eslint \"{app,test}/**/*.{js,jsx,ts,tsx}\"",
    "stylelint": "pnpm run stylelint:check --fix",
    "stylelint:check": "stylelint \"app/**/*.less\"",
    "build:prod": "webpack --bail --mode production",
    "watch": "webpack --progress --watch --mode development",
    "unit-test": "mocha --import=tsx --extension js,ts --reporter spec ./test/unit-test",
    "unit-test-watch": "mocha -w --import=tsx --extension js,ts --reporter spec ./test/unit-test",
    "test": "puppeteer browsers install chrome && node test/runMocha.mts \"${MOCHA_URL:-http://localhost:7021/koski/test/runner.html?bail=${MOCHA_BAIL:-false}&grep=${MOCHA_GREP:-}}\"",
    "playwright:test": "pnpm exec playwright test",
    "playwright:test:debug": "pnpm exec playwright test --headed",
    "playwright:test:trace": "pnpm exec playwright test --trace on && pnpm exec playwright show-report",
    "playwright:codegen": "pnpm exec playwright codegen",
    "playwright:visual": "pnpm exec playwright test --config playwright.visual.config.ts",
    "playwright:visual:update": "pnpm exec playwright test --config playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsconfig.tsbuildinfo --project tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput --project tsconfig.json",
    "prettier": "prettier --write --cache .",
    "prettier:check": "prettier --check --cache .",
    "clean": "if playwright --version >/dev/null 2>&1; then playwright clear-cache; fi && if [ -d ../target/webapp/koski ]; then find ../target/webapp/koski -mindepth 1 -maxdepth 1 ! -name json-schema-viewer -exec rm -rf {} +; fi && rm -rf ../target/webapp/WEB-INF node_modules/.cache test/.pw-state",
    "wipe": "pnpm run clean && pnpm purge && rm -rf test-results playwright-report"
  },
  "packageManager": "pnpm@12.9.1"
}
