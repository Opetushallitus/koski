    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@skidding/react-codemirror": "1.0.2",
    "bacon.atom": "5.0.6",
    "baconjs": "1.0.1",
    "baret": "1.2.0",
    "classnames": "2.5.1",
    "codemirror": "5.65.21",
    "downloadjs": "1.4.7",
    "fecha": "4.2.3",
    "font-awesome": "4.7.0",
    "fp-ts": "2.16.11",
    "js-cookie": "3.0.8",
    "normalize.css": "7.0.0",
    "optics-ts": "2.4.1",
    "partial.lenses": "9.8.0",
    "prop-types": "15.8.1",
    "ramda": "0.32.0",
    "react": "16.14.0",
    "react-day-picker": "7.4.10",
    "react-dom": "16.14.0",
    "react-focus-lock": "2.13.7",
    "react-highlight": "0.15.0",
    "react-highlighter": "0.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@eslint-react/eslint-plugin": "5.22.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.13",
    "@types/downloadjs": "1.4.6",
    "@types/js-cookie": "3.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.0",
    "@types/ramda": "0.32.0",
    "@types/react": "16.14.70",
    "@types/react-dom": "16.9.25",
    "babel-loader": "10.1.1",
    "chai": "4.5.0",
    "copy-webpack-plugin": "13.0.1",
    "css-loader": "7.1.5",
    "eslint": "10.11.0",
    "eslint-plugin-mocha": "12.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "globals": "17.12.0",
    "html2canvas": "1.4.1",
    "jquery": "3.7.1",
    "less": "4.9.1",
    "less-loader": "12.3.3",
    "lodash": "4.18.1",
    "mocha": "10.8.2",
    "moment": "2.31.0",
    "postcss": "8.5.28",
    "postcss-loader": "8.2.1",
    "postcss-preset-env": "10.6.1",
    "puppeteer": "25.12.0",
    "style-loader": "4.0.0",
    "swc-loader": "0.2.7",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  },
  "scripts": {
    "lint": "eslint \"{app,test}/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"{app,test}/**/*.{js,jsx,ts,tsx}\" --fix",
    "build:prod": "webpack --bail --mode production",
    "watch": "webpack --devtool inline-source-map --progress --watch --mode development",
    "unit-test": "mocha --require ts-node/register --extension js,ts --reporter spec ./test/unit-test",
    "unit-test-watch": "mocha -w --require ts-node/register --extension js,ts --reporter spec ./test/unit-test",
    "test": "puppeteer browsers install chrome && node test/runMocha.mts \"${MOCHA_URL:-http://localhost:7021/koski/test/runner.html?bail=${MOCHA_BAIL:-false}&grep=${MOCHA_GREP:-}}\"",
    "playwright:test": "pnpm exec playwright test",
    "playwright:test:debug": "pnpm exec playwright test --headed",
    "playwright:test:trace": "pnpm exec playwright test --trace on && pnpm exec playwright show-report",
    "playwright:codegen": "pnpm exec playwright codegen",
    "playwright:visual": "pnpm exec playwright test --config playwright.visual.config.ts",
    "playwright:visual:update": "pnpm exec playwright test --config playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --project tsconfig.runMocha.json",
    "prettier": "pnpm --dir .. exec prettier --write web/app",
    "prettier:check": "pnpm --dir .. exec prettier --check web/app",
    "prettier:tests": "pnpm --dir .. exec prettier --write web/test"
  },
  "packageManager": "pnpm@10.34.5"
}
